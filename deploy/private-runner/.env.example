# A domain whose A/AAAA record points to this private host.
OPENBOT_DOMAIN=studio.example.com

# Keep this path identical on the host and inside OpenBot so isolated bot
# computers can safely mount their own workspaces through the Docker socket.
OPENBOT_HOST_ROOT=/srv/openbot

# Linux group id that owns /var/run/docker.sock. setup.sh fills this in.
DOCKER_GID=999

# Reviewed OpenCode build used by this OpenBot release.
OPENCODE_VERSION=1.18.28

# Optional release-managed connector clients. Their registered callback must use
# https://your-domain/api/connectors/<provider>/callback
OPENBOT_GOOGLE_CLIENT_ID=
OPENBOT_GOOGLE_CLIENT_SECRET=
OPENBOT_SLACK_CLIENT_ID=
OPENBOT_SLACK_CLIENT_SECRET=
OPENBOT_NOTION_CLIENT_ID=
OPENBOT_NOTION_CLIENT_SECRET=
OPENBOT_DROPBOX_APP_KEY=
OPENBOT_DROPBOX_CLIENT_SECRET=
