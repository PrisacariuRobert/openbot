// The install page at openbots.foundation: static files from site/, plus /download/* which serves the
// Mac bundle from our GitHub releases through Cloudflare's cache (see download-worker.mjs).
//   npx wrangler deploy -c deploy/install-site.wrangler.jsonc
{
  "name": "openbot-install-site",
  "main": "./download-worker.mjs",
  "compatibility_date": "2026-09-23",
  "assets": { "directory": "../site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/download/*"] },
  "workers_dev": true,
  "routes": [
    { "pattern": "openbots.foundation", "custom_domain": true },
    { "pattern": "www.openbots.foundation", "custom_domain": true }
  ]
}
