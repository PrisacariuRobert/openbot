# Optional private always-on runner. Local mode is the default.
# Private runner mode fails closed unless the URL is HTTPS and the data path is absolute.
OPENBOT_DEPLOYMENT_MODE=local
OPENBOT_APP_URL=
OPENBOT_DATA_DIR=

# Shared allowance for one job, including consultations and steered follow-ups.
# Uses provider-reported input/output/reasoning tokens, not an exact billing cap.
# Per-run and per-teammate weekly limits still apply. Valid range: 1000–2000000.
OPENBOT_JOB_MAX_TOKENS=100000

# Optional release-managed Google OAuth client.
# When set, Apps & Tools shows a single Connect Google button.
OPENBOT_GOOGLE_CLIENT_ID=
OPENBOT_GOOGLE_CLIENT_SECRET=

# Optional release-managed Slack OAuth app.
# Add http://127.0.0.1:4311/api/connectors/slack/callback as its redirect URL.
OPENBOT_SLACK_CLIENT_ID=
OPENBOT_SLACK_CLIENT_SECRET=
# Optional release-managed Events API signing secret. The owner can also save it in Apps & Tools.
OPENBOT_SLACK_SIGNING_SECRET=

# Optional release-managed public Notion integration.
# Add http://127.0.0.1:4311/api/connectors/notion/callback as its redirect URL.
OPENBOT_NOTION_CLIENT_ID=
OPENBOT_NOTION_CLIENT_SECRET=
# Optional if an existing Notion webhook subscription already has a verification token.
OPENBOT_NOTION_VERIFICATION_TOKEN=

# Optional release-managed Dropbox OAuth app. Public PKCE clients only require an app key.
# Add http://127.0.0.1:4311/api/connectors/dropbox/callback as its redirect URL.
OPENBOT_DROPBOX_APP_KEY=
# Optional for a confidential Dropbox client. Never put this secret in the iPhone app.
OPENBOT_DROPBOX_CLIENT_SECRET=

# Optional native iPhone push delivery. Keep the downloaded .p8 key on the Mac host.
OPENBOT_APNS_TEAM_ID=
OPENBOT_APNS_KEY_ID=
OPENBOT_APNS_PRIVATE_KEY_PATH=
OPENBOT_APNS_BUNDLE_ID=app.openbot.mobile

# Built-in away access: operator provisioning, not extra apps for users.
# Leave blank until a trusted OpenBot relay with HTTPS is deployed.
# A provider address works, e.g. https://your-relay.onrender.com (no custom domain).
# The relay terminates TLS and is trusted with traffic; this is not E2EE.
OPENBOT_RELAY_URL=
# Private pilot enrollment only. Never embed this operator secret in a public app.
OPENBOT_RELAY_ENROLLMENT_TOKEN=
