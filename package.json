{
  "name": "openbot",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "A local-first, open-source home for persistent AI teammates.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:remote": "OPENBOT_HOST=0.0.0.0 concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"vite --host 0.0.0.0\"",
    "remote": "npm run build && OPENBOT_HOST=0.0.0.0 NODE_ENV=production tsx src/server/index.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "check": "tsc --noEmit",
    "check:ios": "node scripts/check-ios.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run check:release && npm run check:ios && npm test && npm run check && npm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.39.0",
    "music-metadata": "^11.15.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
